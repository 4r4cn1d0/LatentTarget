__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.DS_Store

# Raw experiment data is regenerable and can get large; keep manifests so runs
# stay auditable. Remove these two lines if you want the data version-controlled.
data/raw/*.jsonl
data/processed/*.jsonl
data/processed/**/*.jsonl
data/processed/*.npz
!data/raw/*.manifest.json

# V6's blind-judge caches are part of the frozen provenance graph, not merely
# regenerable derived data. Preserve them alongside the audited raw batches.
!data/processed/v6_semantic_validation/*.jsonl
!data/processed/v6_quality_validation/*.jsonl

# The first real-model checkpoint is small enough to preserve verbatim. Keep
# later large/captured runs ignored unless they are reviewed explicitly.
!data/raw/qwen38_27b_gonogo_20260826.jsonl
!data/processed/qwen38_27b_gonogo_20260826.codex-judge.jsonl

# Preserve the small, final v3 systems checkpoint and both blind measurement
# copies verbatim. These three files are the evidence behind the frozen STOP.
!data/raw/qwen38_27b_v3_checkpoint_20260901.jsonl
!data/processed/qwen38_27b_v3_checkpoint_20260901.gpt-5.6-sol.jsonl
!data/processed/qwen38_27b_v3_checkpoint_20260901.gpt-5.6-luna.jsonl
