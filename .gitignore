__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.DS_Store

# Raw experiment data is regenerable and can get large; keep manifests so runs
# stay auditable. Remove these two lines if you want the data version-controlled.
data/raw/*.jsonl
data/processed/*.jsonl
data/processed/*.npz
!data/raw/*.manifest.json

# The first real-model checkpoint is small enough to preserve verbatim. Keep
# later large/captured runs ignored unless they are reviewed explicitly.
!data/raw/qwen38_27b_gonogo_20260826.jsonl
